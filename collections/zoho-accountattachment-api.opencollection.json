{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter AccountAttachment API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "AccountAttachment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Account attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts/:accountId/attachments",
            "params": [
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Secondary information related to the attachments. Value allowed is creator, which returns the details of users who added the attachments."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API lists the files attached to an account."
        },
        {
          "info": {
            "name": "Create Account attachment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts/:accountId/attachments",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This API attaches a file to an account."
        },
        {
          "info": {
            "name": "Delete Account attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/accounts/:accountId/attachments/:attachmentId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API deletes an attachment from a account."
        }
      ]
    }
  ],
  "bundled": true
}