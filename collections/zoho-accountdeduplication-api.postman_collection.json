        {
          "id": "159215d4-40c3-4e4b-b92b-66b5b5d4517c",
          "name": "List duplicate accounts",
          "request": {
            "name": "List duplicate accounts",
            "description": {
              "content": "This API lists the duplicate entries of an account.The _fieldName_ parameters is mandatory in the API request   <br/></br/>_Note:_<br/> If you encounter a 202 status code while executing this API request, it means there are 100,000 or more accounts in the help desk portal. Matching the records and finding duplicates will be time-consuming in such a scenario. Therefore, the deduplication request will be accepted, and after the process is completed, an automated report will be sent to the user who initiated the deduplication.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "groupAccountDuplicateValues"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fieldName",
                  "value": "<string,null>",
                  "description": "Name of the field whose values must be matched for deduplication.Values allowed are: !@email,@! !@phone,@! and !@accountName@!"
                },
                {
                  "disabled": false,
                  "key": "swFieldValue",
                  "value": "<string,null>",
                  "description": "Key that specifies the letter with which the field values must start"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<string,null,integer-int32>",
                  "description": "Number of accounts to fetch"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string,null,integer-int32>",
                  "description": "Index number starting from which the accounts must be fetched"
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string,null>",
                  "description": "Key that sorts the accounts by a specific attribute: @count@ or @fieldValue@. The default sorting order is ascending. A @-@ prefix denotes descending order of sorting."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
