                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "CONFIG",
                      "value": "{\"tableName\":\"SalesTable\",\"autoIdentify\":\"true\",\"onError\":\"setcolumnempty\",\"batchKey\":\"start\",\"isLastBatch\":\"false\"}"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "workspace-id",
                      "description": "(Required) ID of the workspace."
                    }
                  ]
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) Organization ID (can be obtained using Get Organizations API).",
                    "key": "ZANALYTICS-ORGID",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) The file to be imported as a batch.",
                        "type": "text/plain"
                      },
                      "key": "FILE",
                      "value": "<binary>",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"summary\": \"Create bulk import job\",\n  \"data\": {\n    \"batchKey\": \"1694703482470_1767024000008426012_SalesTable\",\n    \"jobId\": \"1767024000008787011\"\n  }\n}",
