          "name": "Import Data into a New Table (Synchronous)",
          "request": {
            "name": "Import Data into a New Table (Synchronous)",
            "description": {
              "content": "Use the Bulk APIs to create a new table and import data into it synchronously. ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "restapi",
                "v2",
                "workspaces",
                ":workspace-id",
                "data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "CONFIG",
                  "value": "<string>",
                  "description": "(Required) JSONObject with configuration to create a new table and import data on the same. (Refer `ImportConfigNewTable` schema). Value must be stringified and URL-encoded."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspace-id",
                  "description": "(Required) ID of the workspace."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Organization ID (can be obtained using Get Organizations API).",
                "key": "ZANALYTICS-ORGID",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "FILE",
                  "type": "file",
                  "description": "The file to be imported. Only one of FILE or DATA should be provided."
                },
                {
                  "key": "DATA",
                  "value": "<string>",
                  "type": "text",
                  "description": "Raw data (CSV or JSON) to be imported. Only one of FILE or DATA should be provided."
                }
              ]
            }
          },
          "response": [
