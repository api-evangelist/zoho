          "info": {
            "name": "Unmoderate community topic",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/communityTopics/:topicId/unmoderate",
            "params": [
              {
                "name": "topicId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API helps unmoderate a forum topic, which means user comments are published without reviewing."
        },
        {
          "info": {
            "name": "List forum topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/communityTopics",
