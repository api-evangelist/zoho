                "type": "query",
                "description": "Index number, starting from which the topics must be listed"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of topics to list. Values allowed are: @ANNOUNCEMENT@, @DISCUSSION@, @IDEA@, @PROBLEM@, and @QUESTION@."
