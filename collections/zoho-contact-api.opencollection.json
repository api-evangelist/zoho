                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of contacts to fetch"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Index number, starting from which the contacts must be listed"
              },
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API fetches the ticket history of a contact."
        },
