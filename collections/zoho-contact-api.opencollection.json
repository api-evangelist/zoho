              },
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API dissociates a particular account from a contact."
        },
        {
          "info": {
            "name": "Get status of contact in help centers",
            "type": "http"
