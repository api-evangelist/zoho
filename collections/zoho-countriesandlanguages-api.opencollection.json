        {
          "info": {
            "name": "List all countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/countries"
          },
          "docs": "This API lists the countries that can be set in the locale field in Zoho Desk. Keep in mind that the <b>countries</b> object will be deprecated soon. Therefore, make sure to use the <b>data</b> object instead, wherever needed."
        },
        {
          "info": {
            "name": "List all languages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/languages"
          },
          "docs": "This API lists the languages that are available for listing in Zoho Desk."
        },
        {
          "info": {
            "name": "List all time zones",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/timeZones"
          },
          "docs": "This API lists the time zones that are available for listing in Zoho Desk."
        }
      ]
    }
