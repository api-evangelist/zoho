          "name": "Get deleted records from a module",
          "request": {
            "name": "Get deleted records from a module",
            "description": {
              "content": "Retrieve the deleted records for the module. This endpoint can retrieve both permanently deleted records and temporarily deleted records from the recycle bin.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":module",
                "deleted"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "all",
                  "description": "Specifies the type of deleted records to retrieve. Use 'all' to get all deleted records, 'recycle' for records in recycle bin, or 'permanent' for permanently deleted records."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "To get the list of records from the respective pages. Default value for page is 1."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "200",
                  "description": "To get the list of records available per page. The default and the maximum possible value is 200."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "module",
                  "description": "(Required) Specifies the module name"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
