{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter DisplayEntity API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "DisplayEntity",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Auto Display an Entity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/agents/:agentId/:entityName/:entityId/display",
            "params": [
              {
                "name": "agentId",
                "value": "",
                "type": "path",
                "description": "Id of the agent in whose browser the entity to be opened."
              },
              {
                "name": "entityName",
                "value": "",
                "type": "path",
                "description": "Name of the entity that needs to be opened.Values allowed are: tickets, contacts."
              },
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Id of the entity."
              }
            ]
          },
          "docs": "This API is used to instruct an agent's browser to open and display a given entity automatically without any manual action required by the agent."
        }
      ]
    }
  ],
  "bundled": true
}