{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter Features API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Feature Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/__features",
            "params": [
              {
                "name": "module",
                "value": "",
                "type": "query",
                "description": "module name"
              },
              {
                "name": "api_names",
                "value": "",
                "type": "query",
                "description": "Api names of the feature comma separated"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Per Page Count"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              }
            ]
          },
          "docs": "To get the available feature details for the current edition"
        },
        {
          "info": {
            "name": "Get Specific Feature Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/__features/:feature",
            "params": [
              {
                "name": "feature",
                "value": "",
                "type": "path",
                "description": "Feature api name"
              },
              {
                "name": "module",
                "value": "",
                "type": "query",
                "description": "module name"
              }
            ]
          },
          "docs": "To get the available feature specific details for the current edition"
        }
      ]
    }
  ],
  "bundled": true
}