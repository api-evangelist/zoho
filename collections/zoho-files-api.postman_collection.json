        {
          "id": "edaddaaa-5bce-4a6d-b2c5-a1e8026f1d1a",
          "name": "Retrieves a file from ZFS",
          "request": {
            "name": "Retrieves a file from ZFS",
            "description": {
              "content": "Retrieves the binary content of a file stored in Zoho File System (ZFS) using its unique file ID. The file ID is provided as a required query parameter 'id'. If the file exists, the API returns the file's binary data along with appropriate headers indicating the MIME type and content disposition for download. If the file ID does not correspond to any file in ZFS, a 204 No Content response is returned. This endpoint is used to download files that have been previously uploaded to ZFS and associated with Zoho CRM records.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Unique identifier of the file to retrieve"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/octet-stream"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "5c29aa83-b46c-48bf-9236-9b787290aeaa",
              "name": "Successfully uploaded file to Zoho File System. Returns the uploaded file as binary content with appropriate headers indicating the file type and disposition.",
              "originalRequest": {
                "url": {
                  "path": [
                    "files"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "id",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/octet-stream"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Indicates how the content should be displayed. Includes the original filename for download purposes.",
                  "key": "Content-Disposition",
                  "value": "attachment;filename*=UTF-8''image %282%29.png"
                },
                {
                  "key": "Content-Type",
                  "value": "application/octet-stream"
                }
              ],
              "body": "string",
              "cookie": [],
