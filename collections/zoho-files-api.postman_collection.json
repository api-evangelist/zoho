      "item": [
        {
          "id": "71db9175-5365-4b48-9724-37d1615da43a",
          "name": "Uploads a file to ZFS",
          "request": {
            "name": "Uploads a file to ZFS",
            "description": {
              "content": "Uploads a file to Zoho File System (ZFS) and returns the file metadata including the file ID which can be used to associate the file with records in Zoho CRM. The file is uploaded using multipart/form-data with a required 'file' field containing the binary data of the file to be uploaded. The response includes the file ID, name, status, and other details. Can upload 10 files in a single request by repeating the 'file' field. Maximum file size is 20 MB.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "inline",
                  "value": "<string>",
                  "description": "To upload inline images. Possible value: inline"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "(Required) Upload one or more files using repeated 'file' keys."
                }
              ]
            }
          },
          "response": [
            {
              "id": "f9806c77-9910-4bfc-897e-9fd776a05076",
              "name": "Successfully uploaded one or more files to Zoho File System. Returns an array of upload results, one per file, containing the file ID for record association and upload status confirmation.",
              "originalRequest": {
                "url": {
                  "path": [
                    "files"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "inline",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) Upload one or more files using repeated 'file' keys.",
                        "type": "text/plain"
                      },
                      "key": "file",
                      "value": "[\"<binary>\",\"<binary>\"]",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [\n    {\n      \"status\": \"success\",\n      \"code\": \"SUCCESS\",\n      \"message\": \"string\",\n      \"details\": {\n        \"name\": \"string\",\n        \"id\": \"string\"\n      }\n    }\n  ]\n}",
              "cookie": [],
