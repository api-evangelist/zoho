          "name": "Replace picklist values for a global picklist",
          "request": {
            "name": "Replace picklist values for a global picklist",
            "description": {
              "content": "Schedules or executes replacement of picklist values for the specified global picklist. You can specify either `id`, `display_value`, or both for `old_value` and `new_value`. If both are provided, the system validates them for consistency. The `from` (old) value can be non-existent in the current picklist, but the `to` (new) value must be in the **used** state of the picklist option.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settings",
                "global_picklists",
