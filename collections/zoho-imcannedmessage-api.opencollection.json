{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter IMCannedMessage API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "IMCannedMessage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a Template Message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/im/cannedMessages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API fetches details of a template message."
        },
        {
          "info": {
            "name": "List Template Message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/im/cannedMessages",
            "params": [
              {
                "name": "modifiedAfter",
                "value": "",
                "type": "query",
                "description": "After which date entities to be included. Enter a date in the ISO date format of yyyy-MM-ddThh:mm:ss.SSSZ."
              },
              {
                "name": "contactId",
                "value": "",
                "type": "query",
                "description": "Contact id for which the canned message has to be applied"
              },
              {
                "name": "departmentId",
                "value": "",
                "type": "query",
                "description": "Department ID for which the canned messages to be fetched"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of canned messages to fetch"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Index number, starting from which the canned messages must be fetched"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by MessageType. Allowed values are @TEMPLATE@"
              },
              {
                "name": "isActive",
                "value": "",
                "type": "query",
                "description": "Canned Message Active Status"
              }
            ]
          },
          "docs": "This API lists all sessions"
        }
      ]
    }
  ],
  "bundled": true
}