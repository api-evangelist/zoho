          "id": "ace70f3c-f5fb-4685-ab52-a549a96d6baa",
          "name": "Get License Feature Information",
          "request": {
            "name": "Get License Feature Information",
            "description": {
              "content": "Fetches the list of all license features, with optional filters for active status and specific feature codes. Useful for retrieving their current availability (isAllowed) and usage limits. Returns either simple max values or detailed limit information based on the includeDetailedLimits parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "licenses",
                "features"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "featureCodes",
                  "value": "<string>,<string>",
                  "description": "Comma-separated list of feature codes to retrieve information for."
                },
                {
                  "disabled": false,
                  "key": "isAllowed",
                  "value": "<boolean>",
                  "description": "Filter features based on their active status."
                },
                {
                  "disabled": false,
                  "key": "includeDetailedLimits",
                  "value": "<boolean>",
                  "description": "Flag to include detailed per-unit feature limits (max, free, add-on values) instead of only max values."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
