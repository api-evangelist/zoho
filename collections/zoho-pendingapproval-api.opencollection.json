  },
  "items": [
    {
      "info": {
        "name": "PendingApproval",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get my pending approvals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/myPendingApprovals",
            "params": [
              {
                "name": "department",
                "value": "",
                "type": "query",
                "description": "ID of the department from which pending approvals must be fetched. You can pass a specific department ID or @allDepartment@ in the API request."
              }
            ]
          },
          "docs": "This API lists the pending approvals for a given user"
        }
      ]
    }
  ],
  "bundled": true
