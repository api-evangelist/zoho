          "info": {
            "name": "List Task attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tasks/:taskId/attachments",
            "params": [
              {
                "name": "include",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API lists the files attached to a task."
        },
        {
          "info": {
            "name": "Create Task attachment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tasks/:taskId/attachments",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This API attaches a file to a task"
        },
        {
          "info": {
            "name": "Delete Task attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/tasks/:taskId/attachments/:attachmentId",
            "params": [
              {
                "name": "attachmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API removes an attachment from a task."
        }
      ]
    }
  ],
  "bundled": true
