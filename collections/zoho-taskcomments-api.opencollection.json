{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter TaskComments API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "TaskComments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a task comment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tasks/:entityId/comments/:commentId",
            "params": [
              {
                "name": "commentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API fetches a task comment from the portal."
        },
        {
          "info": {
            "name": "Update a task comment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/tasks/:entityId/comments/:commentId",
            "params": [
              {
                "name": "commentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API updates an existing task comment."
        },
        {
          "info": {
            "name": "List all task comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tasks/:entityId/comments",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "No. of comments to fetch"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Index number starting from which the comments must be fetched"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort comments by the @commentedTime@ attribute. The default sorting order is ascending. A @-@ prefix denotes descending order of sorting."
              },
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This API lists a particular number of comments recorded on a task, based on the limit specified."
        },
        {
          "info": {
            "name": "Create a task comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tasks/:entityId/comments",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API adds a comment to a task."
        }
      ]
    }
  ],
  "bundled": true
}