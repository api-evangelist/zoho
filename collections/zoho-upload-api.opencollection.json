{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter Upload API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": " Upload file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/uploads",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This API uploads a file."
        },
        {
          "info": {
            "name": "Upload a file to CRM",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/upload",
            "headers": [
              {
                "name": "X-CRM-ORG",
                "value": ""
              },
              {
                "name": "feature",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Allows uploading a file to the CRM system using multipart/form-data."
        }
      ]
    }
  ],
  "bundled": true
}