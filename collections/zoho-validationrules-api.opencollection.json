{
  "opencollection": "1.0.0",
  "info": {
    "name": "Helpcenter ValidationRules API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "ValidationRules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Validation Rule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/layouts/:layoutId/validationRules/:validationRuleId",
            "params": [
              {
                "name": "validationRuleId",
                "value": "",
                "type": "path"
              },
              {
                "name": "layoutId",
                "value": "",
                "type": "path",
                "description": "Get the rules of the layout"
              }
            ]
          },
          "docs": "This API fetches a validation rule configured for your layout."
        },
        {
          "info": {
            "name": "Update Validation Rule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/layouts/:layoutId/validationRules/:validationRuleId",
            "params": [
              {
                "name": "validationRuleId",
                "value": "",
                "type": "path"
              },
              {
                "name": "layoutId",
                "value": "",
                "type": "path",
                "description": "Get the rules of the layout"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API updates the details of an existing validation rule in a particular layout."
        },
        {
          "info": {
            "name": "Delete Validation Rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/layouts/:layoutId/validationRules/:validationRuleId",
            "params": [
              {
                "name": "validationRuleId",
                "value": "",
                "type": "path"
              },
              {
                "name": "layoutId",
                "value": "",
                "type": "path",
                "description": "Get the rules of the layout"
              }
            ]
          },
          "docs": "This API deletes a validation rule created for a field from a layout."
        },
        {
          "info": {
            "name": "Create Validation Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/layouts/:layoutId/validationRules",
            "params": [
              {
                "name": "layoutId",
                "value": "",
                "type": "path",
                "description": "Get the rules of the layout"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API creates a validation rule for a field in a layout."
        },
        {
          "info": {
            "name": "Get Validation Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/validationRules",
            "params": [
              {
                "name": "searchString",
                "value": "",
                "type": "query",
                "description": "Get the rules that have this search term"
              },
              {
                "name": "executeInHelpCentre",
                "value": "",
                "type": "query",
                "description": "Get the rules that can be executed in help centre"
              },
              {
                "name": "departmentId",
                "value": "",
                "type": "query",
                "description": "Get the rules of the department"
              },
              {
                "name": "module",
                "value": "",
                "type": "query",
                "description": "Name of the module for which you want to fetch the layout rules. Allowed values are tickets, contacts, accounts, tasks, timeEntry, contracts, products, calls, events"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of rules to be fetched. Default is 50"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Index number, starting from which the rules must be fetched"
              },
              {
                "name": "layoutId",
                "value": "",
                "type": "path",
                "description": "Get the rules of the layout"
              }
            ]
          },
          "docs": "This API fetches all the validation rules configured for your department/layout."
        }
      ]
    }
  ],
  "bundled": true
}